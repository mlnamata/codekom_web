{
  "name": "codekom-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/kopiruj-obrazky.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/kopiruj-obrazky.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test --project=e2e-375 --project=e2e-1280",
    "a11y": "playwright test --project=a11y",
    "kontrola:doplnit": "node scripts/kontrola-doplnit.mjs",
    "logo": "node scripts/logo-svg.mjs && node scripts/favicon.mjs",
    "obsah": "node scripts/tvrzeni-z-obsahu.mjs && node scripts/kontrola-obsahu.mjs && node scripts/kontrola-doplnit.mjs",
    "pdf": "node scripts/pdf.mjs",
    "odkazy": "node scripts/odkazy.mjs",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@codekom/tokeny": "workspace:*",
    "@fontsource/inter": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "marked": "18.1.3",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "potrace": "2.1.8",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  }
}
