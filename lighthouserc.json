{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec next start --port 3400",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3400/",
        "http://localhost:3400/cenik",
        "http://localhost:3400/ukazky",
        "http://localhost:3400/ukazky/lipa",
        "http://localhost:3400/kontakt"
      ],
      "numberOfRuns": 3,
      "settings": { "formFactor": "mobile", "screenEmulation": { "mobile": true, "width": 412, "height": 823, "deviceScaleFactor": 1.75 }, "throttlingMethod": "simulate" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
